[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ManufacturerName%
DriverVer = 11/25/2025,21.43.40.356
CatalogFile=AIONVirtualHID.cat
PnpLockdown=1



[Manufacturer]
%ManufacturerName%=AION_Devices,NTamd64

[AION_Devices.NTamd64]
%DeviceDesc%=AION_Device_Install.NTamd64, Root\AIONVirtualHID

[AION_Device_Install.NTamd64]
CopyFiles = AION_CopyFiles.NTamd64

[AION_Device_Install.NTamd64.Services]
AddService = AIONService, 0x00000002, AIONService_Inst.NTamd64

[AIONService_Inst.NTamd64]
DisplayName   = %ServiceDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\AIONVirtualHID.sys

[SourceDisksNames]
1 = %DISK_NAME%

[SourceDisksFiles]
AIONVirtualHID.sys = 1

[DestinationDirs]
AION_CopyFiles.NTamd64 = 12

[AION_CopyFiles.NTamd64]
AIONVirtualHID.sys

[Strings]
ManufacturerName = "AION"
DeviceDesc = "AIONVirtualHID Combined Keyboard and Mouse"
ServiceDisplayName = "AIONVirtualHID driver"
DISK_NAME = "AIONVirtualHID Install Files"
